generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id String @id @default(uuid())

  name     String
  email    String @unique
  password String

  phone String?

  profile_picture String?
  bio             String?

  player_profile Player_profile?
}

model Player_profile {
  player_id String @id @default(uuid())

  user_id String? @unique

  player_name    String
  player_role    PlayerRole
  specialization String?
  batting_style  BattingStyle?
  bowling_style  BowlingStyle @default(NONE)
  rating         Int     @default(0)

  user User? @relation(fields: [user_id], references: [user_id])

  team_member        TeamMember[]
  matches_as_potm    Match[]           @relation("potm")
  player_stat        PlayerStat?
  player_match_stats PlayerMatchStat[]
  striker_balls      Ball[]            @relation("striker")
  non_striker_balls  Ball[]            @relation("non_striker")
  bowled_balls       Ball[]            @relation("bowler")
  fielded_balls      Ball[]            @relation("fielder")
  dismissed_balls    Ball[]            @relation("dismissed_player")
}

model Team {
  team_id String @id @default(uuid())

  team_name   String
  logo        String?
  description String?

  created_at DateTime @default(now())

  team_members        TeamMember[]
  player_match_stats  PlayerMatchStat[]
  batting_innings     InningStat[]      @relation("batting_team")
  bowling_innings     InningStat[]      @relation("bowling_team")
  team1_matches       Match[]           @relation("team1")
  team2_matches       Match[]           @relation("team2")
  toss_winner_matches Match[]           @relation("toss_winner")
  winner_matches      Match[]           @relation("winner_team")
  team_stat           TeamStat?
}

model TeamMember {
  team_id   String
  player_id String

  role_team TeamRole @default(MEMBER)
  status MembershipStatus @default(PENDING)

  requested_role    TeamRole?
  role_requested_at DateTime?

  requested_at DateTime  @default(now())
  joined_at DateTime?  
  left_at   DateTime?

  team Team @relation(fields: [team_id], references: [team_id], onDelete: Cascade)

  player_profile Player_profile @relation(fields: [player_id], references: [player_id])

  @@id([team_id, player_id])
}

model Match {
  match_id       String    @id @default(uuid())
  team1_id       String
  team2_id       String
  match_format   String
  overs          Int
  status         String
  toss_winner    String?
  toss_decision  String?
  winner         String?
  scheduled_time DateTime
  start_time     DateTime?
  end_time       DateTime?
  potm_player_id String?

  balls               Ball[]
  player_match_stats  PlayerMatchStat[]
  innings             InningStat[]
  team1               Team              @relation("team1", fields: [team1_id], references: [team_id])
  team2               Team              @relation("team2", fields: [team2_id], references: [team_id])
  potm_player_profile Player_profile?   @relation("potm", fields: [potm_player_id], references: [player_id])
  toss_winner_team    Team?             @relation("toss_winner", fields: [toss_winner], references: [team_id])
  winner_team         Team?             @relation("winner_team", fields: [winner], references: [team_id])
}

model Ball {
  ball_id             String  @id @default(uuid())
  match_id            String
  innings_id          String
  over_no             Int
  ball_no             Int
  striker_id          String
  non_striker_id      String
  bowler_id           String
  is_wicket           Boolean @default(false)
  dismissal_type      String?
  fielder_id          String?
  dismissed_player_id String?
  is_legal_delivery   Boolean @default(true)
  batsmen_runs        Int     @default(0)
  extra_type          String?
  extra_runs          Int     @default(0)
  is_noball           Boolean @default(false)
  is_wide             Boolean @default(false)
  is_penalty          Boolean @default(false)
  is_freehit          Boolean @default(false)

  match            Match           @relation(fields: [match_id], references: [match_id])
  striker          Player_profile  @relation("striker", fields: [striker_id], references: [player_id])
  non_striker      Player_profile  @relation("non_striker", fields: [non_striker_id], references: [player_id])
  bowler           Player_profile  @relation("bowler", fields: [bowler_id], references: [player_id])
  fielder          Player_profile? @relation("fielder", fields: [fielder_id], references: [player_id])
  dismissed_player Player_profile? @relation("dismissed_player", fields: [dismissed_player_id], references: [player_id])
  inning           InningStat      @relation(fields: [innings_id], references: [innings_id])
}

model PlayerMatchStat {
  match_id  String
  player_id String
  team_id   String

  runs        Int @default(0)
  balls_faced Int @default(0)
  fours       Int @default(0)
  sixes       Int @default(0)

  balls_bowled  Int @default(0)
  wickets       Int @default(0)
  runs_conceded Int @default(0)

  catches   Int @default(0)
  stumpings Int @default(0)
  run_outs  Int @default(0)

  match Match @relation(fields: [match_id], references: [match_id])

  player Player_profile @relation(fields: [player_id], references: [player_id])

  team Team @relation(fields: [team_id], references: [team_id])

  @@id([match_id, player_id])
}

model PlayerStat {
  player_id String @id

  matches Int @default(0)
  innings Int @default(0)

  runs          Int @default(0)
  balls_faced   Int @default(0)
  fours         Int @default(0)
  sixes         Int @default(0)
  highest_score Int @default(0)

  wickets       Int @default(0)
  balls_bowled  Int @default(0)
  runs_conceded Int @default(0)
  maidens       Int @default(0)

  catches   Int @default(0)
  stumpings Int @default(0)
  run_outs  Int @default(0)

  player Player_profile @relation(fields: [player_id], references: [player_id])
}

model InningStat {
  innings_id String @id @default(uuid())

  match_id String

  batting_team_id String
  bowling_team_id String

  total_runs    Int @default(0)
  total_wickets Int @default(0)
  total_balls   Int @default(0)

  total_extras Int @default(0)

  byes         Int @default(0)
  leg_byes     Int @default(0)
  wides        Int @default(0)
  no_balls     Int @default(0)
  penalty_runs Int @default(0)

  match        Match @relation(fields: [match_id], references: [match_id])
  batting_team Team  @relation("batting_team", fields: [batting_team_id], references: [team_id])
  bowling_team Team  @relation("bowling_team", fields: [bowling_team_id], references: [team_id])

  balls Ball[]
}

model TeamStat {
  team_id String @id

  matches Int @default(0)

  wins       Int @default(0)
  losses     Int @default(0)
  ties       Int @default(0)
  no_results Int @default(0)

  runs_scored  Int @default(0)
  balls_faced  Int @default(0)
  wickets_lost Int @default(0)

  runs_conceded Int @default(0)
  balls_bowled  Int @default(0)
  wickets_taken Int @default(0)

  catches   Int @default(0)
  stumpings Int @default(0)
  run_outs  Int @default(0)

  team Team @relation(fields: [team_id], references: [team_id])
}

enum BattingStyle {
  RIGHT_HANDED
  LEFT_HANDED
}

enum BowlingStyle {
  RIGHT_ARM_FAST
  RIGHT_ARM_MEDIUM
  RIGHT_ARM_OFFBREAK
  RIGHT_ARM_LEGBREAK
  LEFT_ARM_FAST
  LEFT_ARM_MEDIUM
  LEFT_ARM_ORTHODOX
  LEFT_ARM_CHINAMAN
  NONE
}

enum PlayerRole {
  BATSMAN
  BOWLER
  ALL_ROUNDER
  WICKET_KEEPER
}

enum DominantHand{
  LEFT_HANDED
  RIGHT_HANDED
}

enum TeamRole {
  CAPTAIN
  VICE_CAPTAIN
  MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  LEFT
  REMOVED
}